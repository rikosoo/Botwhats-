# Serviço do painel + bot. Copie para /etc/systemd/system/botwhats.service
#
#   sudo cp deploy/botwhats.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now botwhats
#
# O app lê o .env da própria pasta, então não é preciso EnvironmentFile aqui.

[Unit]
Description=Botwhats — autoatendimento do consultório no WhatsApp
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/Botwhats-
ExecStart=/usr/bin/node src/index.js
Restart=always
RestartSec=5
# O Chrome é quem consome memória. MemoryHigh segura antes de matar; MemoryMax
# é o teto duro, para o servidor inteiro não travar. Um teto baixo demais
# derruba o serviço no meio da leitura do QR e o código "fica inválido".
MemoryHigh=1200M
MemoryMax=1700M
# O Chrome escreve em $HOME (cache, crashpad). Com ProtectHome=read-only,
# apontar o HOME para a pasta do projeto e o que o deixa abrir.
Environment=HOME=/home/ubuntu/Botwhats-
Environment=XDG_CONFIG_HOME=/home/ubuntu/Botwhats-/.config
Environment=XDG_CACHE_HOME=/home/ubuntu/Botwhats-/.cache

StandardOutput=journal
StandardError=journal
SyslogIdentifier=botwhats

# Endurecimento básico: o serviço não precisa de nada fora da própria pasta.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only
ReadWritePaths=/home/ubuntu/Botwhats-

[Install]
WantedBy=multi-user.target
