# Canal de mensagens: "mock" (simulador no painel) ou "whatsapp" (WhatsApp real via QR Code)
CHANNEL=mock

# Porta do painel web
PORT=3000

# Endereco de escuta. Em servidor na internet, use 127.0.0.1 e acesse por
# tunel SSH — assim o painel nao fica exposto mesmo se o firewall falhar.
HOST=0.0.0.0

# Acesso ao painel (criados na primeira execucao; depois troque pelo painel)
ADMIN_USER=Henrique
ADMIN_PASSWORD=Henrique123

# Ligue quando o painel estiver atras de HTTPS
COOKIE_SECURE=false

# Fuso horario usado pela agenda e pelos lembretes
TZ=America/Sao_Paulo

# Pausa entre mensagens seguidas no canal real (ms). 0 desliga.
TYPING_DELAY_MS=1200

# Ao conectar, o WhatsApp entrega o que chegou enquanto o numero esteve offline.
# Mensagem com mais tempo que isto (minutos) e registrada no painel, mas nao
# recebe resposta automatica — evita responder conversas antigas de uma vez.
IGNORE_OLDER_THAN_MINUTES=10

# Segundos de silencio logo apos conectar o WhatsApp (a fila acumulada chega
# nesse instante e nao deve virar rajada de respostas).
CONNECT_QUIET_SECONDS=30

# Os dados do consultorio (nome, endereco, convenios, medicos, horarios)
# ficam em src/clinic.js e podem ser editados pelo painel, aba Consultorio.

# Disparo em massa: intervalo entre mensagens (ms) e teto de destinatarios
BROADCAST_DELAY_MS=2500
BROADCAST_MAX=200

# Intervalo (ms) em que o agendador verifica lembretes vencidos
SCHEDULER_INTERVAL_MS=30000

# Google Agenda: de quanto em quanto tempo reler os compromissos do medico
# (so vale com a opcao "nao oferecer horarios ocupados" ligada no painel)
GOOGLE_SYNC_MS=300000

# Caminho do Chromium usado pelo whatsapp-web.js (opcional)
# CHROMIUM_PATH=/usr/bin/chromium
